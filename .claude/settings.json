{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Bash(cat *.env*)",
      "Bash(cat *credential*)",
      "Bash(cat *secret*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(grep * *.env*)",
      "Bash(rg * *.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "out=$(bun run test 2>&1) || { echo \"$out\" | tail -40 >&2; echo \"테스트 실패: 모든 테스트가 통과해야 커밋할 수 있습니다.\" >&2; exit 2; }",
            "timeout": 120,
            "statusMessage": "커밋 전 테스트 실행 중..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.sh\""
          }
        ]
      }
    ]
  }
}
